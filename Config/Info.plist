<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode still generates the rest of the keys; this file only carries what
	     the INFOPLIST_KEY_ build settings cannot express: the launch screen's
	     colour, so the app opens on its own blue instead of a white flash. -->
	<!-- Checking for notifications while the app is closed. `remote-notification`
	     is deliberately absent: there is no APNs certificate, no `aps-environment`
	     entitlement and no push service, and a background mode an app cannot use
	     is a review finding. It goes back in the day push does. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.stillerbenjamin.Relays.refresh</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
